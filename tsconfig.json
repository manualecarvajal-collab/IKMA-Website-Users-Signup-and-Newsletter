{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // `video/` es un subproyecto de Remotion con su propio package.json y su
    // propio tsconfig.json. Sus dependencias NO están en el repo (son 423 MB)
    // y Vercel solo instala las de la raíz, así que al comprobar tipos desde
    // aquí fallaba el build con "Cannot find module 'remotion'".
    // Se comprueba con `npx tsc -p video` cuando se trabaja en él.
    "video"
  ]
}
